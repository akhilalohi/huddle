<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>
<h1>Dashboard</h1>

<div class="stats">
  <div class="stat"><span><%= stats.products %></span>Products</div>
  <div class="stat"><span><%= stats.users %></span>Customers</div>
  <div class="stat"><span><%= stats.orders %></span>Orders</div>
  <div class="stat"><span><%= stats.openDeals %></span>Live deals</div>
  <div class="stat"><span><%= money(stats.revenue) %></span>Revenue</div>
  <div class="stat accent"><span><%= money(stats.saved) %></span>Saved by huddles</div>
</div>

<h2>Recent orders</h2>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Date</th><th>Customer</th><th>Total</th><th>Type</th><th>Status</th></tr></thead>
    <tbody>
      <% if (recent.length === 0) { %><tr><td colspan="5" class="muted">No orders yet.</td></tr><% } %>
      <% recent.forEach(function (o) { %>
        <tr>
          <td><%= o.createdAt.toLocaleDateString('en-IN', { dateStyle: 'medium', timeZone: 'Asia/Kolkata' }) %></td>
          <td><%= o.user ? o.user.username : 'Deleted user' %></td>
          <td><%= money(o.totalCost) %></td>
          <td><%= o.source === 'group-deal' ? 'Group deal' : 'Cart' %></td>
          <td><span class="status s-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
