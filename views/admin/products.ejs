<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>
<div class="section-head">
  <h1>Products</h1>
  <a class="btn" href="/admin/products/new">+ Create new</a>
</div>

<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Product code</th><th>Title</th><th>Price</th><th>Category</th><th>Manufacturer</th><th>Available</th><th>Created at</th><th></th></tr></thead>
    <tbody>
      <% if (products.length === 0) { %><tr><td colspan="8" class="muted">No products yet.</td></tr><% } %>
      <% products.forEach(function (p) { %>
        <tr>
          <td><%= p.productCode %></td>
          <td><a href="/products/<%= p._id %>"><%= p.title %></a></td>
          <td><%= money(p.price) %></td>
          <td><%= p.category ? p.category.title : '-' %></td>
          <td><%= p.manufacturer || '-' %></td>
          <td><span class="status <%= p.available ? 's-delivered' : 's-cancelled' %>"><%= p.available ? 'Yes' : 'No' %></span></td>
          <td><%= p.createdAt.toLocaleDateString('en-IN', { dateStyle: 'medium', timeZone: 'Asia/Kolkata' }) %></td>
          <td class="row-actions">
            <a class="btn btn-small btn-ghost" href="/admin/products/<%= p._id %>/edit">Edit</a>
            <form action="/admin/products/<%= p._id %>/delete" method="post" class="inline" onsubmit="return confirm('Delete this product?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-small btn-ghost" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
