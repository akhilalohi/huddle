<%- include('../partials/header') %>
<section class="narrow">
  <h1>Sign In</h1>
  <%- include('../partials/errors', { errors: errors }) %>
  <form action="/user/signin" method="post" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Email address <input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required></label>
    <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn" type="submit">Sign In</button>
  </form>
  <p>Don't have an account? <a href="/user/signup">Sign Up!</a></p>
</section>
<%- include('../partials/footer') %>
