<%- include('partials/header') %>
<section class="narrow">
  <h1>Contact Us</h1>
  <%- include('partials/errors', { errors: errors }) %>
  <form action="/contact" method="post" class="form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name <input name="name" value="<%= form.name || '' %>" required></label>
    <label>Email <input type="email" name="email" value="<%= form.email || '' %>" required></label>
    <label>Message <textarea name="message" rows="5" minlength="10" required><%= form.message || '' %></textarea></label>
    <button class="btn" type="submit">Send message</button>
  </form>
</section>
<%- include('partials/footer') %>
